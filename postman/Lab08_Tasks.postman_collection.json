{
  "info": {
    "name": "Lab 08 Tasks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "newCode",
      "value": "CS-420"
    }
  ],
  "item": [
    {
      "name": "Initial statistics",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/courses/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"seed statistics\",()=>pm.expect(pm.response.json()).to.eql({totalCourses:6,totalCredits:17,overloaded:false}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create cleaned course",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/courses",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\": \" cs-420 \", \"title\": \" Compilers \", \"creditHours\": 3, \"instructor\": \"Dr. Hamza Rauf\", \"department\": \"Computer Science\", \"tags\": [\"Theory\", \"CORE\"]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"newCode\",pm.response.json().code);",
              "pm.test(\"cleaned values\",()=>{pm.expect(pm.response.json().code).to.eql(\"CS-420\");pm.expect(pm.response.json().tags).to.eql([\"theory\",\"core\"]);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate code",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/courses",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\": \"CS-420\", \"title\": \"Compilers\", \"creditHours\": 3, \"instructor\": \"Dr. Hamza Rauf\", \"department\": \"Computer Science\", \"tags\": [\"Theory\", \"CORE\"]}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"conflict body\",()=>pm.expect(pm.response.json().statusCode).to.eql(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Find created",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/courses/{{newCode}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"course body\",()=>pm.expect(pm.response.json().title).to.eql(\"Compilers\"));"
            ]
          }
        }
      ]
    },
